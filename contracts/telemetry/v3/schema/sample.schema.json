{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigap.local/contracts/telemetry/v3/sample.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "record_hash", "kind", "device_id", "boot_id", "sequence", "monotonic_us", "recorded_at", "time_quality", "config_ref", "profile_refs", "sensor_id", "stream", "quality", "reason", "raw", "converted"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "record_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "kind": {"const": "sample"},
    "device_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "boot_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "sequence": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 20},
    "monotonic_us": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 20},
    "recorded_at": {"type": ["string", "null"], "maxLength": 64},
    "time_quality": {"enum": ["UNSYNCED", "SYNCED", "RECONSTRUCTED"]},
    "config_ref": {"$ref": "config-ref.schema.json"},
    "profile_refs": {"type": "array", "maxItems": 16, "items": {"$ref": "profile-ref.schema.json"}},
    "sensor_id": {"enum": ["mq4", "mq135", "mq7", "mq8", "hx711_organic", "hx711_inorganic", "hx711_b3", "ultrasonic_organic", "ultrasonic_inorganic", "ultrasonic_b3", "ds18b20_b3", "sht31_44", "sht31_45"]},
    "stream": {"enum": ["organic", "inorganic", "b3"]},
    "quality": {"enum": ["READY", "WARMING_UP", "HEATER_PHASE", "UNCALIBRATED", "CALIBRATING", "TIMEOUT", "DISCONNECTED", "CRC_ERROR", "STALE", "OUT_OF_RANGE"]},
    "reason": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
    "raw": {},
    "converted": {}
  },
  "allOf": [
    {
      "if": {"properties": {"sensor_id": {"enum": ["hx711_organic", "hx711_inorganic", "hx711_b3"]}}},
      "then": {"properties": {"raw": {"$ref": "sample/hx711.schema.json#/$defs/raw"}, "converted": {"$ref": "sample/hx711.schema.json#/$defs/converted"}}}
    },
    {
      "if": {"properties": {"sensor_id": {"enum": ["ultrasonic_organic", "ultrasonic_inorganic", "ultrasonic_b3"]}}},
      "then": {"properties": {"raw": {"$ref": "sample/ultrasonic.schema.json#/$defs/raw"}, "converted": {"$ref": "sample/ultrasonic.schema.json#/$defs/converted"}}}
    },
    {
      "if": {"properties": {"sensor_id": {"enum": ["mq4", "mq135", "mq7", "mq8"]}}},
      "then": {"properties": {"raw": {"$ref": "sample/mq.schema.json#/$defs/raw"}, "converted": {"$ref": "sample/mq.schema.json#/$defs/converted"}}}
    },
    {
      "if": {"properties": {"sensor_id": {"const": "ds18b20_b3"}}},
      "then": {"properties": {"raw": {"$ref": "sample/ds18b20.schema.json#/$defs/raw"}, "converted": {"$ref": "sample/ds18b20.schema.json#/$defs/converted"}}}
    },
    {
      "if": {"properties": {"sensor_id": {"enum": ["sht31_44", "sht31_45"]}}},
      "then": {"properties": {"raw": {"$ref": "sample/sht31.schema.json#/$defs/raw"}, "converted": {"$ref": "sample/sht31.schema.json#/$defs/converted"}}}
    }
  ]
}
