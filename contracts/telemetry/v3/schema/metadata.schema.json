{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigap.local/contracts/telemetry/v3/metadata.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "record_hash", "kind", "device_id", "boot_id", "sequence", "monotonic_us", "recorded_at", "time_quality", "config_ref", "profile_refs", "metadata_type", "payload"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "record_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "kind": {"const": "metadata"},
    "device_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "boot_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "sequence": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 20},
    "monotonic_us": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 20},
    "recorded_at": {"type": ["string", "null"], "maxLength": 64},
    "time_quality": {"enum": ["UNSYNCED", "SYNCED", "RECONSTRUCTED"]},
    "config_ref": {"$ref": "config-ref.schema.json"},
    "profile_refs": {"type": "array", "maxItems": 16, "items": {"$ref": "profile-ref.schema.json"}},
    "metadata_type": {"enum": ["CONFIG_ACTIVATION", "PROFILE_ACTIVATION", "BOOT", "HEALTH_SNAPSHOT"]},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"metadata_type": {"const": "CONFIG_ACTIVATION"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/config_activation"}}}},
    {"if": {"properties": {"metadata_type": {"const": "PROFILE_ACTIVATION"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/profile_activation"}}}},
    {"if": {"properties": {"metadata_type": {"const": "BOOT"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/boot"}}}},
    {"if": {"properties": {"metadata_type": {"const": "HEALTH_SNAPSHOT"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/health_snapshot"}}}}
  ],
  "$defs": {
    "config_ref": {"$ref": "config-ref.schema.json"},
    "profile_ref": {"$ref": "profile-ref.schema.json"},
    "config_activation": {
      "type": "object", "additionalProperties": false,
      "required": ["config_ref", "previous_config_ref", "reason"],
      "properties": {
        "config_ref": {"$ref": "#/$defs/config_ref"},
        "previous_config_ref": {"anyOf": [{"$ref": "#/$defs/config_ref"}, {"type": "null"}]},
        "reason": {"enum": ["BOOT", "COMMIT", "RECOVERY", "FACTORY_DEFAULT"]}
      }
    },
    "profile_activation": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_ref", "previous_profile_ref", "reason"],
      "properties": {
        "profile_ref": {"$ref": "#/$defs/profile_ref"},
        "previous_profile_ref": {"anyOf": [{"$ref": "#/$defs/profile_ref"}, {"type": "null"}]},
        "reason": {"enum": ["BOOT", "COMMIT", "RECOVERY", "FACTORY_DEFAULT"]}
      }
    },
    "boot": {
      "type": "object", "additionalProperties": false,
      "required": ["firmware_version", "reset_reason"],
      "properties": {
        "firmware_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "reset_reason": {"enum": ["POWER_ON", "BROWNOUT", "WATCHDOG", "SOFTWARE", "UNKNOWN"]}
      }
    },
    "health_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["entries"],
      "properties": {"entries": {"type": "array", "items": {"$ref": "#/$defs/health_entry"}}}
    },
    "health_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["sensor_id", "health", "readiness", "last_attempt_monotonic_us", "last_ready_monotonic_us"],
      "properties": {
        "sensor_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "health": {"enum": ["ONLINE", "DEGRADED", "FAILED", "UNKNOWN"]},
        "readiness": {"enum": ["READY", "WARMING_UP", "HEATER_PHASE", "UNCALIBRATED", "CALIBRATING", "TIMEOUT", "DISCONNECTED", "CRC_ERROR", "STALE", "OUT_OF_RANGE"]},
        "last_attempt_monotonic_us": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 20},
        "last_ready_monotonic_us": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 20}
      }
    }
  }
}
