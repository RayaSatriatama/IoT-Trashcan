{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sigap:calibration:mq135-relative:MQG1",
  "title": "MQ135 device-authored relative-response control evidence, MQG1",
  "description": "Additive existing device-control result; not a telemetry-v3 sample. uint32/uint64/int64 limits, identity pairs, response-source age equality, source-read freshness and ratio consistency also require semantic validation. No physical or concentration certification is implied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sensor",
    "quality",
    "reason",
    "raw_counts",
    "adc_method",
    "adc_pin_mv",
    "ao_mv",
    "rs_ohm",
    "r0_ohm",
    "rs_over_r0",
    "nh3_ppm",
    "nh3_status",
    "profile_state",
    "profile_version",
    "profile_hash",
    "previous_profile_version",
    "previous_profile_hash",
    "adc_profile_version",
    "adc_profile_hash",
    "source_sequence",
    "source_boot_id",
    "source_monotonic_us",
    "response_monotonic_us",
    "age_us",
    "max_age_us",
    "fresh",
    "hardware_identity",
    "reference_environment",
    "reference_temperature_centi_c",
    "reference_humidity_centi_pct",
    "calibration_epoch_ms",
    "calibration_time_quality",
    "sample_count",
    "variation_percent",
    "circuit_mv",
    "module_load_ohm",
    "divider_top_ohm",
    "divider_bottom_ohm",
    "topology"
  ],
  "properties": {
    "schema": {
      "const": "MQG1"
    },
    "sensor": {
      "const": "mq135"
    },
    "quality": {
      "enum": [
        "READY",
        "CALIBRATING",
        "WARMING_UP",
        "HEATER_PHASE",
        "UNCALIBRATED",
        "STALE",
        "TIMEOUT",
        "DISCONNECTED",
        "CRC_ERROR",
        "OUT_OF_RANGE",
        "INVALID"
      ]
    },
    "reason": {
      "enum": [
        "NONE",
        "GAS_PROFILE_MISSING",
        "NO_SOURCE",
        "RAW_MISSING",
        "SOURCE_IDENTITY_INVALID",
        "ADC_UNVERIFIED",
        "ADC_PROFILE_CHANGED",
        "SOURCE_NOT_READY",
        "SOURCE_CLOCK_UNKNOWN",
        "SOURCE_STALE",
        "GAS_PROFILE_INVALID",
        "REFERENCE_PENDING",
        "ADC_SATURATED",
        "DIVIDER_MISMATCH",
        "AO_OUT_OF_RANGE",
        "ELECTRICAL_UNVERIFIED",
        "ELECTRICAL_OR_SOURCE_INVALID"
      ]
    },
    "raw_counts": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 65535
    },
    "adc_method": {
      "const": "PROFILE_LINEAR"
    },
    "adc_pin_mv": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "ao_mv": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "rs_ohm": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "r0_ohm": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "rs_over_r0": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "nh3_ppm": {
      "type": "null",
      "description": "MQG1 never conveys an NH3 concentration."
    },
    "nh3_status": {
      "const": "UNCALIBRATED"
    },
    "profile_state": {
      "enum": [
        "MISSING",
        "INVALID",
        "TEST_ONLY",
        "VALID"
      ]
    },
    "profile_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[1-9][0-9]{0,9}$",
      "maxLength": 10
    },
    "profile_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "previous_profile_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[1-9][0-9]{0,9}$",
      "maxLength": 10
    },
    "previous_profile_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "adc_profile_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[1-9][0-9]{0,9}$",
      "maxLength": 10
    },
    "adc_profile_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_sequence": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20
    },
    "source_boot_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{32}$"
    },
    "source_monotonic_us": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20
    },
    "response_monotonic_us": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20
    },
    "age_us": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20
    },
    "max_age_us": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20
    },
    "fresh": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "hardware_identity": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_.:-]{1,31}$"
    },
    "reference_environment": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_.:-]{1,31}$"
    },
    "reference_temperature_centi_c": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "reference_humidity_centi_pct": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 10000
    },
    "calibration_epoch_ms": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(0|-?[1-9][0-9]{0,18})$",
      "maxLength": 20
    },
    "calibration_time_quality": {
      "enum": [
        "UNSYNCED",
        "SYNCHRONIZED",
        "ESTIMATED"
      ]
    },
    "sample_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 3,
      "maximum": 64
    },
    "variation_percent": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "circuit_mv": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "module_load_ohm": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "divider_top_ohm": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "divider_bottom_ohm": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "topology": {
      "enum": [
        null,
        1,
        2
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "quality": {
            "const": "READY"
          }
        }
      },
      "then": {
        "properties": {
          "fresh": {
            "const": true
          },
          "reason": {
            "const": "NONE"
          },
          "profile_state": {
            "enum": [
              "TEST_ONLY",
              "VALID"
            ]
          },
          "rs_ohm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "r0_ohm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rs_over_r0": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  ]
}
